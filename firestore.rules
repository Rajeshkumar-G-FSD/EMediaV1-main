rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Quick Quote Tool submissions (src/components/BudgetEstimator.tsx).
    // Anyone can create a booking from the public site; only signed-in
    // admins (src/components/admin/AdminLogin.tsx) can read or update them.
    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Consultation form submissions (src/components/InquiryForm.tsx),
    // shown in the admin dashboard as "Quotes Enquiry". The client already
    // validates these fields, but Firestore rules re-check them here since
    // this project has no custom backend server to do it authoritatively.
    match /quoteEnquiries/{enquiryId} {
      allow create: if
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 60 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^[0-9]{10}$') &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$') &&
        request.resource.data.serviceType is string &&
        request.resource.data.serviceType.size() > 0 &&
        request.resource.data.notes is string &&
        request.resource.data.notes.size() <= 500 &&
        request.resource.data.category == 'Quotes Enquiry' &&
        request.resource.data.status == 'pending';
      allow read, update, delete: if request.auth != null;
    }

    // Competition registration ("போட்டி பதிவு") submissions
    // (src/components/competition/CompetitionForm.tsx). The doc ID is always
    // "<mobile>_<competitionId>" (set client-side), so a second registration
    // attempt for the same mobile + competition hits this same document —
    // since it already exists, Firestore treats that write as an `update`,
    // not a `create`, and the update rule below rejects it for anonymous
    // callers. That gives duplicate-prevention without granting public
    // read/list access to the collection (which would leak every
    // participant's name, phone, and address to anyone who queries it).
    match /participants/{participantId} {
      allow create: if
        participantId == request.resource.data.mobile + '_' + request.resource.data.competitionId &&
        request.resource.data.registrationNumber is string &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 60 &&
        request.resource.data.mobile is string &&
        request.resource.data.mobile.matches('^[0-9]{10}$') &&
        request.resource.data.competitionId is string &&
        request.resource.data.entryFee is number &&
        request.resource.data.paymentStatus == 'pending_payment' &&
        request.resource.data.verificationStatus == 'pending';
      // The public payment step (src/components/competition/CompetitionPaymentPage.tsx)
      // attaches the transaction ID and screenshot URL after the row already
      // exists, before the participant is signed in. Signed-in admins can
      // update any field (verification status, remarks, etc).
      allow update: if request.auth != null ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['transactionId', 'paymentScreenshotURL', 'paymentStatus', 'updatedAt']) &&
         request.resource.data.paymentStatus == 'payment_submitted');
      allow get, list, delete: if request.auth != null;
    }

    // Sequential registration-number counter
    // (src/lib/registrationNumber.ts), one document per calendar year.
    match /counters/{counterId} {
      allow get, write: if true;
      allow list: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
